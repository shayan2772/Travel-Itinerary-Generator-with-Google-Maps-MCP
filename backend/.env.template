# Travel Chat Application Configuration
# Copy this file to .env and fill in your actual API keys

# Required: OpenAI API Key for LangChain/AI functionality
OPENAI_API_KEY=your_openai_api_key_here

# Required: Google Maps API Key for location data and images
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: MCP Server Path (default shown below)
MCP_SERVER_PATH=npx -y @cablate/mcp-google-map

# Optional: Server Configuration
DEBUG=true
HOST=localhost
PORT=8000
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# How to get API keys:
# 1. OpenAI: https://platform.openai.com/api-keys
# 2. Google Maps: https://console.cloud.google.com/apis/credentials
#    - Enable: Places API, Maps JavaScript API, Geocoding API
